# Chatwoot Production Configuration
# ==================================
# Скопируйте этот файл в .env.production и заполните значения

# 1. General Setup
# ----------------
FRONTEND_URL=https://chatwoot.udobno.tech

# Secret Key Base - ОБЯЗАТЕЛЬНО сгенерируйте новый!
# Сгенерировать: openssl rand -hex 64
SECRET_KEY_BASE=ЗАМЕНИТЕ_ЭТОТ_КЛЮЧ_НА_СВОЙ

# 2. Database
# -----------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production

# 3. Redis
# --------
REDIS_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
REDIS_URL=redis://:ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ@redis:6379

# 4. Rails/Node Environment
# --------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true

# 5. Mailer (опционально, но рекомендуется)
# ------------------------------------------
# Без этого не будут работать email уведомления
MAILER_SENDER_EMAIL=Chatwoot <noreply@udobno.tech>
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_DOMAIN=udobno.tech
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# 6. Storage
# ----------
ACTIVE_STORAGE_SERVICE=local

# 7. Force SSL
# ------------
FORCE_SSL=true

# 8. Other Settings
# -----------------
RAILS_MAX_THREADS=5
