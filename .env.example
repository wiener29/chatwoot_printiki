# Chatwoot Environment Configuration
# ==================================

# 1. General Setup
# ----------------
# URL configuration is critical for callbacks and webhooks.
#
# LOCAL DEVELOPMENT (Docker Compose / Default):
# FRONTEND_URL=http://localhost:3000
#
# PRODUCTION DEPLOYMENT:
# FRONTEND_URL=https://chat.yourdomain.com
#
FRONTEND_URL=http://localhost:3000

# Secret Key Base: Generate using `bundle exec rails secret` or `openssl rand -hex 64`
# CRITICAL: Keep this secret in production!
SECRET_KEY_BASE=development_secret_key_base_replace_in_production

# 2. Database
# -----------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production

# Redis
REDIS_URL=redis://redis:6379

# 3. Email
# --------
# MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.com>
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_DOMAIN=chatwoot.com

# 4. Storage (Optional for Local, Required for Prod scaling)
# --------------------------------------------------------
# ACTIVE_STORAGE_SERVICE=local

# 5. AI Agent (Gemini)
# --------------------
# DEPRECATED: GEMINI_API_KEY is now configured via the Super Admin UI -> Configuration
# GEMINI_API_KEY=

# 6. Legacy / Optional Channels
# -----------------------------
# FB_APP_ID=
# FB_APP_SECRET=
